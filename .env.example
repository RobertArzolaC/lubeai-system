DEBUG=True
SECRET_KEY=your_secret_key
DJANGO_SETTINGS_MODULE=config.settings.development

ALLOWED_HOSTS=*
SENTRY_DSN=

# Public host name of the platform (landing page). Tenant hosts derive from it:
# <tenant-slug>.<PLATFORM_DOMAIN>.
PLATFORM_DOMAIN=localhost

# Suffix used to derive a tenant host when --domain is omitted. Leave it empty
# when clients use unrelated domains: provision_tenant then requires --domain
# instead of inventing a host.
TENANT_HOST_SUFFIX=localhost

# --- Production only (config/settings/production.py) ------------------------

# Reverse proxy. This app does not terminate TLS; nginx/Caddy/Traefik does and
# must forward the original scheme and host, otherwise Django believes every
# request is HTTP and builds http:// links.
# (SECURE_PROXY_SSL_HEADER and USE_X_FORWARDED_HOST are set in the settings.)

# Origins accepted for unsafe requests. Empty derives them as https origins
# from ALLOWED_HOSTS, expanding the leading-dot subdomain wildcard.
# CSRF_TRUSTED_ORIGINS=

# Cookies over TLS. Set to False only for a deliberate HTTP-only deployment.
# CSRF_COOKIE_SECURE=True
# SESSION_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True

# Do NOT set SESSION_COOKIE_DOMAIN/CSRF_COOKIE_DOMAIN: sessions live in each
# tenant's schema, so a cookie shared across subdomains would break isolation.
# The settings refuse to start when either is present.

# PostgreSQL (Docker)
POSTGRES_DB=django
POSTGRES_USER=django
POSTGRES_PASSWORD=django

# Host ports
DJANGO_PORT=8000
WEB_CONCURRENCY=3

EMAIL_HOST=live.smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Project Name.us <site@project-name.com>"
